<Project>

  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Authors>Suresh Subramanian</Authors>
    <Company>Hermex</Company>
    <Product>Hermex</Product>
    <Copyright>Copyright (c) Suresh Subramanian</Copyright>
    <NeutralLanguage>en-US</NeutralLanguage>
  </PropertyGroup>

  <!-- Build gate: the recommended .NET analyzers, and any warning fails the build (including
       NuGet vulnerability advisories). Intentional opt-outs live in .editorconfig with a reason. -->
  <PropertyGroup>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

</Project>
