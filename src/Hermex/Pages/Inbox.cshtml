@page "/hermex"
@{
    ViewData["Title"] = "Inbox";
}

<div class="m4d-inbox" id="m4d-inbox">
    <aside class="m4d-rail">
        <div class="m4d-rail__head">
            <span>Mailboxes</span>
        </div>
        <ul class="m4d-rail__list" id="m4d-mailbox-list"></ul>
    </aside>

    <aside class="m4d-pane m4d-pane--list">
        <div class="m4d-pane__head">
            <div class="m4d-search">
                <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8" /><path d="m21 21-4.3-4.3" /></svg>
                <input type="search" id="m4d-search" placeholder="Search, or from: to: subject: is:unread…" autocomplete="off"
                       aria-describedby="m4d-search-help" />
            </div>
            <details class="m4d-search-help" id="m4d-search-help">
                <summary>Search operators</summary>
                <dl>
                    <div><dt><code>from:</code> <code>to:</code> <code>cc:</code> <code>subject:</code> <code>mailbox:</code></dt><dd>Text in that field</dd></div>
                    <div><dt><code>is:read</code> <code>is:unread</code></dt><dd>Read state</dd></div>
                    <div><dt><code>has:attachment</code> <code>has:html</code></dt><dd>Content</dd></div>
                    <div><dt><code>larger:10kb</code> <code>smaller:1mb</code></dt><dd>Message size</dd></div>
                    <div><dt><code>after:2026-11-20</code> <code>before:2026-11-21</code></dt><dd>Received date (UTC)</dd></div>
                    <div><dt><code>"exact phrase"</code> <code>-word</code></dt><dd>Phrase; exclude a term</dd></div>
                </dl>
            </details>
            <div class="m4d-pane__tools">
                <label class="m4d-toggle">
                    <input type="checkbox" id="m4d-unread-only" />
                    <span>Unread only</span>
                </label>
                <div class="m4d-pane__tools-spacer"></div>
                <button type="button" class="m4d-icon-btn" id="m4d-refresh" title="Refresh" aria-label="Refresh messages">
                    <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12a9 9 0 0 1 15-6.7L21 8" /><path d="M21 3v5h-5" /><path d="M21 12a9 9 0 0 1-15 6.7L3 16" /><path d="M3 21v-5h5" /></svg>
                </button>
                <button type="button" class="m4d-btn m4d-btn--danger m4d-btn--sm" id="m4d-delete-mailbox" hidden
                        title="Delete this mailbox and the messages only it holds">
                    <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 12h-6l-2 3h-4l-2-3H2" /><path d="M5.45 5.11 2 12v6a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-6l-3.45-6.89A2 2 0 0 0 16.76 4H7.24a2 2 0 0 0-1.79 1.11z" /><path d="m9 8 6 0" /></svg>
                    <span>Delete mailbox</span>
                </button>
                <button type="button" class="m4d-btn m4d-btn--danger m4d-btn--sm" id="m4d-clear" title="Delete every message in every mailbox" aria-label="Delete all messages in every mailbox">
                    <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 6h18" /><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6" /><path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2" /></svg>
                    <span>Delete all</span>
                </button>
            </div>
            <div class="m4d-selbar" id="m4d-selbar">
                <label class="m4d-selbar__all">
                    <input type="checkbox" id="m4d-select-all" aria-label="Select all messages on this page" />
                </label>
                <span class="m4d-selbar__count" id="m4d-sel-count" role="status"></span>
                <span class="m4d-selbar__spacer"></span>
                @* Icons are filled in by inbox.js from its single icon set. *@
                <button type="button" class="m4d-icon-btn m4d-icon-btn--sm" id="m4d-sel-read" disabled
                        title="Mark selected as read" aria-label="Mark selected messages as read"></button>
                <button type="button" class="m4d-icon-btn m4d-icon-btn--sm" id="m4d-sel-unread" disabled
                        title="Mark selected as unread" aria-label="Mark selected messages as unread"></button>
                <button type="button" class="m4d-btn m4d-btn--danger m4d-btn--sm" id="m4d-sel-delete" disabled>
                    <span id="m4d-sel-delete-label">Delete</span>
                </button>
            </div>
            <div class="m4d-stripe" id="m4d-list-stats">
                <span class="m4d-stripe__item"><strong id="m4d-stat-total">0</strong> messages</span>
                <span class="m4d-stripe__item"><strong id="m4d-stat-unread">0</strong> unread</span>
                <span class="m4d-stripe__item m4d-stripe__item--muted" id="m4d-stat-size">0 B</span>
            </div>
        </div>

        <ul class="m4d-msg-list" id="m4d-msg-list" role="listbox" aria-label="Messages"></ul>

        <div class="m4d-empty" id="m4d-list-empty" hidden>
            <svg viewBox="0 0 24 24" width="40" height="40" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16" rx="3" /><path d="m3 7 9 6 9-6" /></svg>
            <p class="m4d-empty__title">No messages yet</p>
            <p class="m4d-empty__hint">Send mail to the SMTP server and it will appear here instantly.</p>
        </div>

        <div class="m4d-pager" id="m4d-pager"></div>
    </aside>

    <section class="m4d-pane m4d-pane--detail" id="m4d-detail-pane">
        <div class="m4d-empty m4d-empty--detail" id="m4d-detail-empty">
            <svg viewBox="0 0 24 24" width="44" height="44" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z" /><path d="m22 6-10 7L2 6" /></svg>
            <p class="m4d-empty__title">Select a message</p>
            <p class="m4d-empty__hint">Choose a message from the list to inspect its content, headers and attachments.</p>
        </div>
        <article class="m4d-detail" id="m4d-detail" hidden></article>
    </section>
</div>

@section Scripts {
    <script src="/hermex/assets/js/inbox.js"></script>
}
